    "seed:events": "tsx --env-file=.env.local scripts/seed-events-only.ts",
    "seed:clients": "tsx --env-file=.env.local scripts/seed-clients.ts",
    "seed:conferences": "tsx --env-file=.env.local scripts/seed-conferences.ts",
    "seed:news": "tsx --env-file=.env.local scripts/seed-news.ts",
    "seed:retail-media-summit": "tsx --env-file=.env.local scripts/seed-retail-media-summit.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^6.2.0",
    "@react-three/fiber": "^9.6.1",
    "@sanity/client": "^7.22.0",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
